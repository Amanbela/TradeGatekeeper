# ==========================================
# TradeGatekeeper - Production .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (NEVER COMMIT)
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
credentials.json
service-account*.json

# ------------------------------------------
# Node.js Dependencies & Cache
# ------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store

# ------------------------------------------
# Node.js Build & Compiled Outputs
# ------------------------------------------
dist/
**/dist/
build/
out/
coverage/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# ------------------------------------------
# Python Microservice & ML Artifacts
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.xgb
*.pkl
*.joblib
*.h5
*.onnx
venv/
.venv/
env/

# ------------------------------------------
# Laravel & PHP Framework Rules
# ------------------------------------------
vendor/
**/vendor/
public/build/
public/hot/
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*
!storage/framework/cache/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore
!bootstrap/cache/.gitignore

# ------------------------------------------
# Logs, Databases & Runtime Files
# ------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# IDE & Editor Files
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ------------------------------------------
# OS & Temporary Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
*.tmp
*.temp
