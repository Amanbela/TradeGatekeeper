# ==========================================
# TradeGatekeeper Environment Configuration
# ==========================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=production

# Admin API Authorization Key (Required for /kill-switch & /ml/train endpoints)
TRADEGATEKEEPER_ADMIN_API_KEY=your_secure_admin_api_key_here

# SmartAPI (Angel One) Broker Credentials
SMARTAPI_API_KEY=your_smartapi_api_key_here
SMARTAPI_CLIENT_CODE=your_client_code_here
SMARTAPI_PIN=1234
SMARTAPI_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_KEY

# Database & Cache URIs
MONGO_URI=mongodb://mongodb:27017/tradegatekeeper
REDIS_HOST=redis
REDIS_PORT=6379

# Internal Microservices
ML_SERVICE_URL=http://ml-service:8000

# ML Microservice Operating Mode ('advisory' | 'gating', default 'advisory')
ML_MODE=advisory

# Quantitative Strategy Parameters
NIFTY_LOT_SIZE=50
SIGNAL_MAX_AGE_BARS=4
ADX_ENTRY_THRESHOLD=20.0
ADX_RISING_REQUIRED=false

# Risk Management Limits
MAX_DAILY_LOSS=5000.00
MAX_CONSECUTIVE_LOSSES=3
MAX_CAPITAL_EXPOSURE=100000.00

# Optional Testing & Bypass Controls (set to 'true' to override during development)
FORCE_RMS_BYPASS=false
BYPASS_INDICATOR_CHECK=false
